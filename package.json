{
  "name": "@citisen/dsh-sentry",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: watch every session from another tab — a status ring on the original fish favicon, a tab-title prefix, and a synthesized chime",
  "type": "module",
  "license": "MIT",
  "author": "citisen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citisen/dsh-sentry.git"
  },
  "homepage": "https://github.com/citisen/dsh-sentry#readme",
  "bugs": {
    "url": "https://github.com/citisen/dsh-sentry/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "src",
    "scripts",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "watch": "node scripts/build-client.mjs --watch",
    "browser": "node scripts/browser-check.mjs",
    "icon": "node scripts/icon-render-check.mjs",
    "verify": "node scripts/verify-host.mjs && node scripts/verify-settings.mjs && node scripts/verify-client.mjs && node scripts/browser-check.mjs && node scripts/icon-render-check.mjs",
    "check": "node scripts/build-client.mjs --check && npm run verify",
    "check:all": "npm run check && node scripts/verify-profile.mjs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "web-ui",
    "favicon",
    "tab-title",
    "notification",
    "sound",
    "web-audio",
    "background-tab",
    "session-status"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
